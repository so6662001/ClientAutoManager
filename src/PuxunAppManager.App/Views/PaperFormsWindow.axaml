<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PuxunAppManager.App.ViewModels"
        x:Class="PuxunAppManager.App.Views.PaperFormsWindow"
        x:DataType="vm:PaperFormsViewModel"
        Width="880" Height="680"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Title="纸型管理 · 普讯科技应用管家">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 头部 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="26,20,26,12">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#0067c0" Offset="0"/>
                        <GradientStop Color="#6b3fd1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="纸" FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="纸型管理" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="管理本机打印服务器的纸型（表单）· 新增 / 编辑 / 删除"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="26,0,26,16">
            <StackPanel Spacing="16">

                <!-- 新建/编辑纸型 -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="新建纸型" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <!-- 分段选择器 -->
                        <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource StrokeStrong}"
                                BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton Content="一式二等份" Classes="seg"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=TwoEqual, Mode=OneWay}"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="2"/>
                                <ToggleButton Content="一式三等份" Classes="seg"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=ThreeEqual, Mode=OneWay}"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="3"/>
                                <ToggleButton Content="自定义" Classes="seg"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Custom, Mode=OneWay}"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="c"/>
                            </StackPanel>
                        </Border>

                        <!-- 字段 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="纸型名称" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Text="{Binding Name}" Watermark="例如：收银小票二联"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,9,0">
                                <TextBlock Text="整张纸 宽 (mm)" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <NumericUpDown Value="{Binding WidthMm}" Minimum="1" Maximum="2000" Increment="1" FormatString="0.#"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" Margin="9,0,0,0">
                                <TextBlock Text="整张纸 高 (mm)" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <NumericUpDown Value="{Binding HeightMm}" Minimum="1" Maximum="2000" Increment="1" FormatString="0.#"/>
                            </StackPanel>
                        </Grid>

                        <!-- 自定义边距 -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsCustom}">
                            <TextBlock Text="可打印边距 (mm)" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                            <Grid ColumnDefinitions="*,*,*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="上" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                    <NumericUpDown Value="{Binding MarginTop}" Minimum="0" Maximum="2000" Increment="1" FormatString="0.#"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0">
                                    <TextBlock Text="下" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                    <NumericUpDown Value="{Binding MarginBottom}" Minimum="0" Maximum="2000" Increment="1" FormatString="0.#"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" Margin="6,0">
                                    <TextBlock Text="左" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                    <NumericUpDown Value="{Binding MarginLeft}" Minimum="0" Maximum="2000" Increment="1" FormatString="0.#"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="右" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                    <NumericUpDown Value="{Binding MarginRight}" Minimum="0" Maximum="2000" Increment="1" FormatString="0.#"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 等份提示 -->
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,8"
                                HorizontalAlignment="Left" IsVisible="{Binding !IsCustom}">
                            <TextBlock Text="{Binding PartHint}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <!-- 重复提示（红） -->
                        <Border Background="#fde7e4" CornerRadius="8" Padding="10,9"
                                HorizontalAlignment="Left" IsVisible="{Binding HasDuplicate}">
                            <TextBlock Text="{Binding DuplicateMessage}" FontSize="12.5" Foreground="#c42b1c"/>
                        </Border>

                        <!-- 结果提示 -->
                        <TextBlock Text="{Binding ResultMessage}" FontSize="12.5" IsVisible="{Binding HasResult}"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

                        <!-- 操作 -->
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Classes="primary" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}"
                                    IsEnabled="{Binding !IsBusy}"/>
                            <Button Classes="ghost" Content="取消编辑" Command="{Binding CancelEditCommand}"
                                    IsVisible="{Binding IsEditing}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                                       Text="增 / 改 / 删 需管理员权限（将弹出一次 UAC）"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 已存在纸型列表 -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="已存在纸型" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="（来自本机打印服务器，含系统内置）" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <!-- 表头 -->
                            <Grid ColumnDefinitions="2.4*,1.4*,1.6*,0.8*,1.2*,1.4*" Margin="14,11"
                                  Background="Transparent">
                                <TextBlock Grid.Column="0" Text="名称" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Grid.Column="1" Text="类别" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Grid.Column="2" Text="宽 × 高 (mm)" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Grid.Column="3" Text="等份" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Grid.Column="4" Text="每份高 (mm)" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Grid.Column="5" Text="操作" FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CardStroke}"/>

                            <ItemsControl ItemsSource="{Binding Forms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PaperTypeItemViewModel">
                                        <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="2.4*,1.4*,1.6*,0.8*,1.2*,1.4*" Margin="14,12">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" CornerRadius="11" Padding="9,2" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Background="{Binding TagBackground}">
                                                    <TextBlock Text="{Binding CategoryText}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding TagForeground}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PartsText}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PartHeightText}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="ghost" Content="编辑" Padding="10,5" FontSize="12"
                                                            Command="{Binding EditCommand}" IsVisible="{Binding CanModify}"/>
                                                    <Button Classes="ghost" Content="删除" Padding="10,5" FontSize="12"
                                                            Foreground="#c42b1c" Command="{Binding DeleteCommand}"
                                                            IsVisible="{Binding CanModify}"/>
                                                    <TextBlock Text="内置不可改/删" FontSize="11.5" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               IsVisible="{Binding IsBuiltIn}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Height="34" Background="{DynamicResource WindowBackground}"
                BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#0f8a4f"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="普讯科技应用管家 v1.0.0" FontSize="12"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
